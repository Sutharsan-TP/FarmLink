# MongoDB connection string. Leave as "memory" (or blank) to run against a
# disposable in-memory MongoDB with auto-seeded demo data and no external
# setup required. Point it at a real MongoDB instance for persistent data.
MONGODB_URI=memory

# Secret used to sign JWTs issued by /api/auth routes
JWT_SECRET=change-this-secret

# Port the Express server listens on
PORT=5000

# OpenWeather API key, used by POST /api/advisory to fetch the 5-day/3-hour forecast
# (https://openweathermap.org/forecast5). If unset, advisory requests continue
# without weather data instead of failing.
WEATHER_API_KEY=

# Base URL for an OpenAI-compatible Ollama server used to generate the advisory text
OLLAMA_BASE_URL=http://localhost:11434/v1

# Local Ollama model name to use for advisory generation
OLLAMA_MODEL=gemma4:e2b-it-q4_K_M
